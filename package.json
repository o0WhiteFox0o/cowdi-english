{
  "name": "cowdi-english",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "prebuild": "node scripts/build-lesson-ids.mjs && node scripts/validate-lessons.mjs && node scripts/validate-lessons.mjs --questions --fail-on-hard",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "validate:questions": "node scripts/validate-lessons.mjs --questions --fail-on-hard",
    "build": "vite build",
    "build:prod": "vite build --config vite.config.prod.js --mode production",
    "preview": "vite preview",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test": "node --test \"shared/*.test.js\" \"server/tests/*.test.mjs\" \"server/routes/*.test.js\" \"src/data/quiz/*.test.js\" \"src/features/placement/*.test.js\" \"src/pet-rig/*.test.mjs\" \"src/pet-director/*.test.mjs\" \"src/features/vocab/*.test.js\" \"src/utils/*.test.js\" \"src/features/lesson/screens/*.test.mjs\""
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-background-sync": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  }
}
